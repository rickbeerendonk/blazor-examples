<div class="comment">Open the browser console to see the returned values.</div>

@code {
    [JSInvokable]
    public static double GetRandomNumber()
    {
        double value = Random.Shared.NextDouble();
        Console.WriteLine($"C# returns: {value}");
        return value;
    }
}
