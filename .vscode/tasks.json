{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start",
      "runOptions": {
        "instanceLimit": 1,
        "reevaluateOnRerun": true
      },
      "type": "shell",
      "command": "d='${fileDirname}'; until ls \"$d\"/*.csproj >/dev/null 2>&1; do d=$(dirname \"$d\"); [ \"$d\" = / ] && break; done; dotnet watch --project \"$d\" run",
      "windows": {
        "command": "$d='${fileDirname}'; while(-not (Test-Path \"$d\\*.csproj\")){ $d=Split-Path $d -Parent; if([string]::IsNullOrEmpty($d)){ break } }; dotnet watch --project \"$d\" run"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      }
    },
    {
      "label": "Start-Without-Debugging",
      "runOptions": {
        "instanceLimit": 3,
        "reevaluateOnRerun": true
      },
      "type": "shell",
      "command": "d='${fileDirname}'; until ls \"$d\"/*.csproj >/dev/null 2>&1; do d=$(dirname \"$d\"); [ \"$d\" = / ] && break; done; dotnet run --project \"$d\"",
      "windows": {
        "command": "$d='${fileDirname}'; while(-not (Test-Path \"$d\\*.csproj\")){ $d=Split-Path $d -Parent; if([string]::IsNullOrEmpty($d)){ break } }; dotnet run --project \"$d\""
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false
      }
    }
  ]
}
